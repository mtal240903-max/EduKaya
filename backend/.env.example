PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/edukaya
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string

# Micro-service Python (algorithme SM-2 de répétition espacée) — voir /revision-engine
# Si absent ou injoignable, le backend Node bascule automatiquement sur son
# implémentation JS de secours (src/utils/sm2.js) : la fonctionnalité ne casse jamais.
PYTHON_ENGINE_URL=http://localhost:8000

# FedaPay — paiement des abonnements
# Clé secrète (test ou live) : Dashboard FedaPay → Workbench → API Keys
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxxx
FEDAPAY_ENV=sandbox
# Secret du webhook : Dashboard FedaPay → Workbench → Webhooks → ton endpoint → "Click to reveal"
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxxxxxxxxx
# URL publique de TON backend (pas localhost !) — FedaPay doit pouvoir l'atteindre
# pour envoyer le webhook. En test local, utilise ngrok (voir LISEZMOI.md).
APP_PUBLIC_URL=https://ton-backend-public.exemple.com

# Cloudinary — upload des documents (exécuté UNIQUEMENT par ce serveur, jamais
# par l'app mobile : voir src/config/cloudinary.js pour le pourquoi).
# Dashboard Cloudinary → en haut de la page, trois champs "Cloud name" / "API Key" / "API Secret".
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ton_api_key
CLOUDINARY_API_SECRET=ton_api_secret

# Origines autorisées à appeler cette API en CORS (séparées par des virgules).
# Sans effet sur l'app mobile (qui n'envoie pas d'en-tête Origin) — ne concerne
# qu'un éventuel client web (ex. un futur back-office navigateur).
# Laisser vide en dev désactive la restriction ; à renseigner en production.
CORS_ALLOWED_ORIGINS=
